                    <div>
                      <div style={{fontWeight:700,fontSize:15}}>{a.nome}</div>
                      <div style={{fontSize:12,color:MU}}>{t?.nome} · {a.tipo_sanguineo||"—"}</div>
                    </div>
                  </div>
                  <div style={{textAlign:"right",flexShrink:0}}>
                    {elig
                      ?<span style={{background:"#f0fdf4",color:G,border:"1px solid #bbf7d0",borderRadius:20,padding:"4px 10px",fontSize:12,fontWeight:700}}>✅ Disponível</span>
                      :dl2<=14
                        ?<span style={{background:"#fffbeb",color:Y,border:"1px solid #fde68a",borderRadius:20,padding:"4px 10px",fontSize:12,fontWeight:700}}>{dl2}d</span>
                        :<span style={{background:"#f1f5f9",color:MU,borderRadius:20,padding:"4px 10px",fontSize:12,fontWeight:700}}>{dl2}d</span>
                    }
                    {last&&<div style={{fontSize:10,color:MU,marginTop:4}}>Última: {fmtDate(last.data_coleta)}</div>}
                  </div>
                </div>
              );
            })}
          </>
        }
        <Btn full v="sec" onClick={closeModal}>Cancelar</Btn>
      </Sheet>}

      {modal?.type==="delColeta"&&<Sheet title="Excluir Coleta" onClose={closeModal}>
        <p style={{color:MU,fontSize:15,marginBottom:20}}>Excluir a coleta de <strong>{fmtDate(modal.payload.dataColeta)}</strong>?</p>
        <div style={{display:"flex",gap:10}}>
          <Btn full v="danger" onClick={()=>delColeta(modal.payload.coletaId)}>Excluir</Btn>
          <Btn full v="sec" onClick={closeModal}>Cancelar</Btn>
        </div>
      </Sheet>}

      {modal?.type==="editMeta"&&<Sheet title={form.id?"Editar Meta":"Nova Meta"} onClose={closeModal}>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
          <FLD label="Mês"><select style={SEL} value={form.mes||nowM} onChange={e=>sf("mes",parseInt(e.target.value))}>{Array.from({length:12},(_,i)=><option key={i+1} value={i+1}>{mName(i+1)}</option>)}</select></FLD>
          <FLD label="Ano"><input style={INP} type="number" value={form.ano||nowY} onChange={e=>sf("ano",parseInt(e.target.value))}/></FLD>
          <FLD label="🐶 Meta Cães"><input style={INP} type="number" min={0} value={form.meta_caes||""} onChange={e=>sf("meta_caes",e.target.value)} placeholder="0"/></FLD>
          <FLD label="🐱 Meta Gatos"><input style={INP} type="number" min={0} value={form.meta_gatos||""} onChange={e=>sf("meta_gatos",e.target.value)} placeholder="0"/></FLD>
        </div>
        <div style={{background:"#f1f5f9",borderRadius:8,padding:12,marginBottom:14,fontSize:13,color:MU}}>
          Total da meta: <strong>{(parseInt(form.meta_caes)||0)+(parseInt(form.meta_gatos)||0)} coletas/mês</strong>
        </div>
        <div style={{display:"flex",gap:10}}>
          <Btn full onClick={saveMeta}>Salvar Meta</Btn>
          <Btn full v="sec" onClick={closeModal}>Cancelar</Btn>
        </div>
      </Sheet>}

    </div>
  );
}
