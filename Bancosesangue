import { useState, useMemo, useCallback } from "react";

const USERS = [{ login: "gabrielle", senha: "123456", nome: "Gabrielle" }];

let _id = 200;
const uid = () => String(++_id);
const daysAgo = (d) => { const dt = new Date(); dt.setDate(dt.getDate() - d); return dt.toISOString().split("T")[0]; };
const todayStr = () => new Date().toISOString().split("T")[0];
const daysSince = (d) => Math.floor((Date.now() - new Date(d + "T00:00:00")) / 86400000);
const fmtDate = (d) => d ? new Date(d + "T00:00:00").toLocaleDateString("pt-BR") : "—";
const sIcon = (e) => e === "gato" ? "🐱" : "🐶";
const mName = (m) => ["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"][m-1];

const T0 = [
  { id:"t1", nome:"Carlos Mendes", telefone:"(11) 98765-4321", email:"carlos@email.com", cidade:"São Paulo" },
  { id:"t2", nome:"Ana Souza",     telefone:"(11) 91234-5678", email:"ana@email.com",    cidade:"Campinas" },
  { id:"t3", nome:"João Lima",     telefone:"(21) 99876-5432", email:"joao@email.com",   cidade:"Rio de Janeiro" },
];
const A0 = [
  { id:"a1", tutor_id:"t1", nome:"Thor",  especie:"cachorro", raca:"Labrador",         peso:32,  idade:4, sexo:"M", tipo_sanguineo:"DEA 1.1+", status:"coletado" },
  { id:"a2", tutor_id:"t2", nome:"Luna",  especie:"gato",     raca:"SRD",              peso:5.2, idade:3, sexo:"F", tipo_sanguineo:"A",        status:"coletado" },
  { id:"a3", tutor_id:"t3", nome:"Max",   especie:"cachorro", raca:"Golden Retriever", peso:28,  idade:5, sexo:"M", tipo_sanguineo:"DEA 1.1-", status:"apto"     },
  { id:"a4", tutor_id:"t1", nome:"Mel",   especie:"cachorro", raca:"Beagle",           peso:14,  idade:2, sexo:"F", tipo_sanguineo:"DEA 1.1+", status:"cadastrado"},
  { id:"a5", tutor_id:"t2", nome:"Mia",   especie:"gato",     raca:"Persa",            peso:4.8, idade:4, sexo:"F", tipo_sanguineo:"B",        status:"coletado" },
];
const TR0 = [
  { id:"tr1", animal_id:"a1", apto:true, data_triagem:daysAgo(100), observacoes:"", responsavel:"Dra. Carla" },
  { id:"tr2", animal_id:"a2", apto:true, data_triagem:daysAgo(65),  observacoes:"", responsavel:"Dr. Felipe" },
  { id:"tr3", animal_id:"a3", apto:true, data_triagem:daysAgo(10),  observacoes:"", responsavel:"Dra. Carla" },
  { id:"tr4", animal_id:"a5", apto:true, data_triagem:daysAgo(80),  observacoes:"", responsavel:"Dr. Felipe" },
];
const C0 = [
  { id:"c1", animal_id:"a1", data_coleta:daysAgo(95), volume_ml:450, responsavel:"Dra. Carla"  },
  { id:"c2", animal_id:"a2", data_coleta:daysAgo(60), volume_ml:50,  responsavel:"Dr. Felipe"  },
  { id:"c3", animal_id:"a5", data_coleta:daysAgo(76), volume_ml:50,  responsavel:"Dra. Carla"  },
];
const M0 = [{ id:"m1", ano:new Date().getFullYear(), mes:new Date().getMonth()+1, meta_caes:8, meta_gatos:4 }];

const R = "#dc2626"; const G = "#16a34a"; const Y = "#d97706";
const MU = "#64748b"; const BO = "#e2e8f0"; const TX = "#0f172a";
const STAT = {
  cadastrado: ["#eff6ff","#3b82f6","Cadastrado"],
  triagem:    ["#fffbeb","#d97706","Em Triagem"],
  apto:       ["#f0fdf4","#16a34a","Apto"],
  inapto:     ["#fef2f2","#dc2626","Inapto"],
  coletado:   ["#f5f3ff","#7c3aed","Coletado"],
};

const INP = { width:"100%", padding:"11px 14px", borderRadius:10, border:"1.5px solid #e2e8f0", fontSize:15, fontFamily:"inherit", color:TX, outline:"none", background:"#fff", boxSizing:"border-box", WebkitAppearance:"none" };
const SEL = { ...INP, appearance:"none", WebkitAppearance:"none" };

const Bdg = ({s}) => { const [bg,cl,lb]=STAT[s]||STAT.cadastrado; return <span style={{background:bg,color:cl,border:`1px solid ${cl}33`,borderRadius:20,padding:"3px 10px",fontSize:11,fontWeight:700,whiteSpace:"nowrap"}}>{lb}</span>; };

const Btn = ({children,onClick,v="red",full,style:ex={}}) => {
  const VS = { red:{background:R,color:"#fff"}, sec:{background:"#f1f5f9",color:TX}, ghost:{background:"transparent",color:MU}, danger:{background:"#fef2f2",color:R,border:"1px solid #fca5a5"}, green:{background:G,color:"#fff"}, outline:{background:"#fff",color:R,border:`1.5px solid ${R}`} };
  return <button style={{border:"none",borderRadius:10,fontWeight:700,fontSize:14,padding:"11px 20px",cursor:"pointer",fontFamily:"inherit",width:full?"100%":"auto",WebkitTapHighlightColor:"transparent",...VS[v],...ex}} onClick={onClick}>{children}</button>;
};

const FLD = ({label,children}) => (
  <div style={{marginBottom:16}}>
    <label style={{display:"block",fontSize:12,fontWeight:700,color:MU,marginBottom:6,textTransform:"uppercase",letterSpacing:.5}}>{label}</label>
    {children}
  </div>
);

const Sheet = ({title, onClose, children}) => (
  <div style={{position:"fixed",inset:0,background:"rgba(0,0,0,.55)",zIndex:1000,display:"flex",alignItems:"flex-end",justifyContent:"center"}} onClick={onClose}>
    <div style={{background:"#fff",borderRadius:"20px 20px 0 0",padding:"0 0 env(safe-area-inset-bottom,16px)",maxWidth:600,width:"100%",maxHeight:"92vh",display:"flex",flexDirection:"column",boxShadow:"0 -8px 40px rgba(0,0,0,.18)"}} onClick={e=>e.stopPropagation()}>
      {/* drag handle */}
      <div style={{display:"flex",justifyContent:"center",padding:"12px 0 0"}}>
        <div style={{width:36,height:4,background:"#e2e8f0",borderRadius:4}}/>
      </div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"12px 20px 14px"}}>
        <h2 style={{margin:0,fontSize:17,fontWeight:800,color:TX}}>{title}</h2>
        <button onClick={onClose} style={{border:"none",background:"#f1f5f9",borderRadius:8,width:32,height:32,cursor:"pointer",fontSize:18,color:MU,lineHeight:1,display:"flex",alignItems:"center",justifyContent:"center"}}>×</button>
      </div>
      <div style={{overflowY:"auto",padding:"0 20px 24px",flex:1}}>{children}</div>
    </div>
  </div>
);

const Toast = ({msg,ok}) => <div style={{position:"fixed",bottom:90,left:"50%",transform:"translateX(-50%)",zIndex:2000,background:ok?"#f0fdf4":"#fef2f2",color:ok?"#16a34a":"#dc2626",border:`1px solid ${ok?"#bbf7d0":"#fca5a5"}`,borderRadius:12,padding:"11px 20px",fontWeight:700,fontSize:13,boxShadow:"0 8px 24px rgba(0,0,0,.15)",whiteSpace:"nowrap"}}>{ok?"✅":"❌"} {msg}</div>;

// ─── CARD ─────────────────────────────────────────────────────────────────────
const Card = ({children,style={}}) => <div style={{background:"#fff",borderRadius:14,border:`1px solid ${BO}`,padding:16,...style}}>{children}</div>;

export default function App() {
  const [user,    setUser]    = useState(null);
  const [tab,     setTab]     = useState("dashboard");
  const [tutores, setTutores] = useState(T0);
  const [animais, setAnimais] = useState(A0);
  const [triagens,setTriagens]= useState(TR0);
  const [coletas, setColetas] = useState(C0);
  const [metas,   setMetas]   = useState(M0);
  const [modal,   setModal]   = useState(null);
  const [form,    setForm]    = useState({});
  const [toast,   setToast]   = useState(null);
  const [srch,    setSrch]    = useState("");
  const [loginV,  setLoginV]  = useState("");
  const [senhaV,  setSenhaV]  = useState("");
  const [loginErr,setLoginErr]= useState("");

  const showToast = (msg,ok=true) => { setToast({msg,ok}); setTimeout(()=>setToast(null),2500); };
  const sf = (k,v) => setForm(f=>({...f,[k]:v}));
  const openModal  = useCallback((type,payload={},initForm={}) => { setModal({type,payload}); setForm(initForm); },[]);
  const closeModal = useCallback(() => { setModal(null); setForm({}); },[]);

  const doLogin = () => {
    const u=USERS.find(x=>x.login===loginV.trim()&&x.senha===senhaV);
    if(u){ setUser(u); setLoginErr(""); } else setLoginErr("Login ou senha incorretos.");
  };

  const lastCol = useCallback((aid)=>[...coletas].sort((a,b)=>new Date(b.data_coleta)-new Date(a.data_coleta)).find(c=>c.animal_id===aid),[coletas]);
  const isElig  = useCallback((a)=>{ const l=lastCol(a.id); if(!l)return a.status==="apto"; return daysSince(l.data_coleta)>=90; },[lastCol]);
  const dLeft   = useCallback((a)=>{ const l=lastCol(a.id); if(!l)return 0; return Math.max(0,90-daysSince(l.data_coleta)); },[lastCol]);
  const isAlert = useCallback((a)=>{ const d=dLeft(a); return d>0&&d<=14; },[dLeft]);
  const nowM = new Date().getMonth()+1, nowY = new Date().getFullYear();

  const stats = useMemo(()=>{
    const mc=coletas.filter(c=>{ const d=new Date(c.data_coleta+"T00:00:00"); return d.getMonth()+1===nowM&&d.getFullYear()===nowY; });
    const meta=metas.find(m=>m.ano===nowY&&m.mes===nowM);
    return {
      total:animais.length,
      caes:animais.filter(a=>a.especie==="cachorro").length,
      gatos:animais.filter(a=>a.especie==="gato").length,
      aptos:animais.filter(a=>a.status==="apto"||a.status==="coletado").length,
      prontos:animais.filter(a=>isElig(a)&&(a.status==="apto"||a.status==="coletado")).length,
      aguard:animais.filter(a=>{ const l=lastCol(a.id); return l&&daysSince(l.data_coleta)<90; }).length,
      alertas:animais.filter(isAlert).length,
      coletasMes:mc.length,
      cc:mc.filter(c=>animais.find(a=>a.id===c.animal_id)?.especie==="cachorro").length,
      cg:mc.filter(c=>animais.find(a=>a.id===c.animal_id)?.especie==="gato").length,
      metaCaes:meta?.meta_caes||0, metaGatos:meta?.meta_gatos||0,
      metaTotal:(meta?.meta_caes||0)+(meta?.meta_gatos||0),
    };
  },[animais,coletas,metas,isElig,isAlert,lastCol,nowM,nowY]);

  const pct = stats.metaTotal>0?Math.min(100,Math.round(stats.coletasMes/stats.metaTotal*100)):0;
  const alertAnimais   = useMemo(()=>animais.filter(isAlert).sort((a,b)=>dLeft(a)-dLeft(b)),[animais,isAlert,dLeft]);
  const prontosAnimais = useMemo(()=>animais.filter(a=>isElig(a)&&(a.status==="apto"||a.status==="coletado")),[animais,isElig]);
  const aptosParaColeta= useMemo(()=>animais.filter(a=>a.status==="apto"||a.status==="coletado"),[animais]);
  const tutor = (tid) => tutores.find(x=>x.id===tid);

  // CRUD
  const saveTutor = () => {
    if(!form.nome?.trim())return;
    if(form.id) setTutores(p=>p.map(x=>x.id===form.id?{...x,...form}:x));
    else setTutores(p=>[...p,{...form,id:uid()}]);
    showToast(form.id?"Tutor atualizado!":"Tutor cadastrado!"); closeModal();
  };
  const delTutor = (id) => {
    const aids=animais.filter(a=>a.tutor_id===id).map(a=>a.id);
    setTutores(p=>p.filter(x=>x.id!==id));
    setAnimais(p=>p.filter(a=>a.tutor_id!==id));
    setTriagens(p=>p.filter(t=>!aids.includes(t.animal_id)));
    setColetas(p=>p.filter(c=>!aids.includes(c.animal_id)));
    showToast("Tutor excluído."); closeModal();
  };
  const saveAnimal = () => {
    if(!form.nome?.trim()||!form.especie||!form.tutor_id)return;
    if(form.id) setAnimais(p=>p.map(x=>x.id===form.id?{...x,...form}:x));
    else setAnimais(p=>[...p,{...form,id:uid(),status:"cadastrado"}]);
    showToast(form.id?"Animal atualizado!":"Animal cadastrado!"); closeModal();
  };
  const delAnimal = (id) => {
    setAnimais(p=>p.filter(x=>x.id!==id));
    setTriagens(p=>p.filter(x=>x.animal_id!==id));
    setColetas(p=>p.filter(x=>x.animal_id!==id));
    showToast("Animal excluído."); closeModal();
  };
  const saveTriagem = () => {
    const aid=modal.payload.animalId;
    if(!form.apto)return;
    const apto=form.apto==="true";
    setTriagens(p=>[...p,{id:uid(),animal_id:aid,apto,data_triagem:form.data_triagem||todayStr(),observacoes:form.observacoes||"",responsavel:form.responsavel||""}]);
    setAnimais(p=>p.map(x=>x.id===aid?{...x,status:apto?"apto":"inapto"}:x));
    showToast("Triagem registrada!"); closeModal();
  };
  const saveColeta = () => {
    const aid=modal.payload.animalId;
    if(!form.data_coleta||!form.volume_ml)return;
    setColetas(p=>[...p,{id:uid(),animal_id:aid,data_coleta:form.data_coleta,volume_ml:parseFloat(form.volume_ml),responsavel:form.responsavel||"",observacoes:form.observacoes||""}]);
    setAnimais(p=>p.map(x=>x.id===aid?{...x,status:"coletado"}:x));
    showToast("Coleta registrada!"); closeModal();
  };
  const delColeta = (id) => { setColetas(p=>p.filter(x=>x.id!==id)); showToast("Coleta excluída."); closeModal(); };
  const saveMeta = () => {
    const ano=parseInt(form.ano), mes=parseInt(form.mes);
    if(!ano||!mes)return;
    const d={ano,mes,meta_caes:parseInt(form.meta_caes)||0,meta_gatos:parseInt(form.meta_gatos)||0};
    const ex=metas.find(m=>m.ano===ano&&m.mes===mes&&m.id!==form.id);
    if(ex) setMetas(p=>p.map(m=>m.id===ex.id?{...m,...d}:m));
    else if(form.id) setMetas(p=>p.map(m=>m.id===form.id?{...m,...d}:m));
    else setMetas(p=>[...p,{...d,id:uid()}]);
    showToast("Meta salva!"); closeModal();
  };
  const delMeta = (id) => { setMetas(p=>p.filter(x=>x.id!==id)); showToast("Meta excluída."); };

  // ── LOGIN ──────────────────────────────────────────────────────────────────
  if(!user) return (
    <div style={{minHeight:"100vh",background:"linear-gradient(160deg,#0f172a 0%,#1e1b4b 60%,#0f172a 100%)",display:"flex",alignItems:"center",justifyContent:"center",padding:20,fontFamily:"'DM Sans','Segoe UI',sans-serif"}}>
      <div style={{background:"#fff",borderRadius:24,padding:"40px 28px",width:"100%",maxWidth:380,boxShadow:"0 32px 80px rgba(0,0,0,.45)"}}>
        <div style={{textAlign:"center",marginBottom:28}}>
          <div style={{width:64,height:64,background:"#fee2e2",borderRadius:18,display:"flex",alignItems:"center",justifyContent:"center",fontSize:32,margin:"0 auto 16px"}}>🩸</div>
          <h1 style={{margin:"0 0 4px",fontSize:24,fontWeight:900,color:TX}}>HemoVet</h1>
          <p style={{margin:0,color:MU,fontSize:14}}>Banco de Sangue Animal</p>
        </div>
        <FLD label="Login"><input style={INP} value={loginV} onChange={e=>setLoginV(e.target.value)} onKeyDown={e=>e.key==="Enter"&&doLogin()} placeholder="gabrielle" autoFocus/></FLD>
        <div style={{marginBottom:20}}><FLD label="Senha"><input style={INP} type="password" value={senhaV} onChange={e=>setSenhaV(e.target.value)} onKeyDown={e=>e.key==="Enter"&&doLogin()} placeholder="123456"/></FLD></div>
        {loginErr&&<div style={{color:R,fontSize:13,marginBottom:14,background:"#fef2f2",borderRadius:8,padding:"8px 12px"}}>{loginErr}</div>}
        <Btn full onClick={doLogin}>Entrar</Btn>
        <p style={{textAlign:"center",marginTop:14,fontSize:12,color:MU}}>Login: <strong>gabrielle</strong> · Senha: <strong>123456</strong></p>
      </div>
    </div>
  );

  // ── BOTTOM NAV ─────────────────────────────────────────────────────────────
  const NAV = [
    { id:"dashboard", icon:"◎",  label:"Início" },
    { id:"animais",   icon:"🐾", label:"Animais" },
    { id:"tutores",   icon:"👤", label:"Tutores" },
    { id:"coletas",   icon:"🩸", label:"Coletas" },
    { id:"metas",     icon:"🎯", label:"Metas"   },
  ];

  return (
    <div style={{fontFamily:"'DM Sans','Segoe UI',sans-serif",background:"#f8fafc",minHeight:"100vh",paddingBottom:72}}>

      {/* ── HEADER ── */}
      <header style={{background:"#0f172a",padding:"16px 20px 14px",display:"flex",alignItems:"center",justifyContent:"space-between",position:"sticky",top:0,zIndex:40}}>
        <div style={{display:"flex",alignItems:"center",gap:10}}>
          <div style={{width:32,height:32,background:R,borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",fontSize:16}}>🩸</div>
          <div>
            <div style={{color:"#fff",fontWeight:900,fontSize:15,lineHeight:1}}>HemoVet</div>
            <div style={{color:"#64748b",fontSize:11}}>Banco de Sangue Animal</div>
          </div>
        </div>
        <div style={{display:"flex",alignItems:"center",gap:10}}>
          {stats.alertas>0&&<div style={{background:R,color:"#fff",borderRadius:20,padding:"2px 8px",fontSize:11,fontWeight:700}}>⚠️ {stats.alertas}</div>}
          <button onClick={()=>setUser(null)} style={{background:"#1e293b",border:"none",borderRadius:8,color:"#94a3b8",padding:"6px 10px",fontSize:12,cursor:"pointer"}}>Sair</button>
        </div>
      </header>

      {/* ── CONTENT ── */}
      <div style={{padding:"16px 16px 0",maxWidth:640,margin:"0 auto"}}>

        {/* ═══ DASHBOARD ═══ */}
        {tab==="dashboard"&&<div>
          <h2 style={{fontSize:18,fontWeight:900,marginBottom:14,color:TX}}>Dashboard</h2>

          {/* hero coletas */}
          <div style={{background:"linear-gradient(135deg,#dc2626,#7c3aed)",borderRadius:16,padding:20,marginBottom:14,color:"#fff"}}>
            <div style={{fontSize:11,fontWeight:600,opacity:.8,marginBottom:2,letterSpacing:.5}}>COLETAS EM {mName(nowM).toUpperCase()} / {nowY}</div>
            <div style={{fontSize:52,fontWeight:900,lineHeight:1,marginBottom:4}}>{stats.coletasMes}</div>
            <div style={{fontSize:12,opacity:.8}}>{sIcon("cachorro")} {stats.cc} cães · {sIcon("gato")} {stats.cg} gatos</div>
            {stats.metaTotal>0&&<>
              <div style={{background:"rgba(255,255,255,.2)",borderRadius:8,height:7,overflow:"hidden",marginTop:12}}>
                <div style={{background:"#fff",height:"100%",borderRadius:8,width:`${pct}%`}}/>
              </div>
              <div style={{display:"flex",justifyContent:"space-between",marginTop:5,fontSize:11,opacity:.85}}>
                <span>Meta: {stats.metaTotal} coletas</span>
                <span>{pct}%</span>
              </div>
            </>}
          </div>

          {/* stat cards 2x2 */}
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:14}}>
            {[
              {l:"Cadastrados",v:stats.total,  s:`${stats.caes}🐶 ${stats.gatos}🐱`,c:"#3b82f6"},
              {l:"Aptos",       v:stats.aptos,  s:"triagem aprovada",                c:"#10b981"},
              {l:"Aguardando",  v:stats.aguard, s:"dentro do prazo 90d",             c:"#8b5cf6"},
              {l:"P/ Coletar",  v:stats.prontos,s:"disponíveis agora",              c:R},
            ].map((x,i)=>(
              <div key={i} style={{background:"#fff",borderRadius:12,border:`1px solid ${BO}`,padding:14,position:"relative",overflow:"hidden"}}>
                <div style={{position:"absolute",top:0,left:0,right:0,height:3,background:x.c}}/>
                <div style={{fontSize:26,fontWeight:900,color:x.c,lineHeight:1}}>{x.v}</div>
                <div style={{fontSize:12,fontWeight:700,marginTop:2,color:TX}}>{x.l}</div>
                <div style={{fontSize:10,color:MU,marginTop:1}}>{x.s}</div>
              </div>
            ))}
          </div>

          {/* alertas */}
          {alertAnimais.length>0&&<Card style={{marginBottom:14,border:"1.5px solid #fca5a5"}}>
            <div style={{fontWeight:700,fontSize:13,color:R,marginBottom:12}}>⚠️ Próximos a Liberar</div>
            {alertAnimais.map(a=>{
              const d=dLeft(a);
              return <div key={a.id} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"10px 0",borderBottom:`1px solid ${BO}`}}>
                <div style={{display:"flex",gap:10,alignItems:"center"}}>
                  <div style={{width:36,height:36,background:"#fee2e2",borderRadius:9,display:"flex",alignItems:"center",justifyContent:"center",fontSize:20}}>{sIcon(a.especie)}</div>
                  <div>
                    <div style={{fontWeight:700,fontSize:14}}>{a.nome}</div>
                    <div style={{fontSize:12,color:MU}}>{tutor(a.tutor_id)?.nome}</div>
                  </div>
                </div>
                <div style={{textAlign:"right"}}>
                  <div style={{fontWeight:900,fontSize:18,color:d<=7?R:Y}}>{d}d</div>
                  <div style={{fontSize:10,color:MU}}>para liberar</div>
                </div>
              </div>;
            })}
          </Card>}

          {/* prontos */}
          <Card style={{border:"1.5px solid #bbf7d0"}}>
            <div style={{fontWeight:700,fontSize:13,color:G,marginBottom:12}}>✅ Prontos para Coletar</div>
            {prontosAnimais.length===0
              ?<p style={{color:MU,fontSize:13,margin:0}}>Nenhum disponível agora.</p>
              :prontosAnimais.map(a=>{
                const last=lastCol(a.id);
                return <div key={a.id} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"10px 0",borderBottom:`1px solid ${BO}`}}>
                  <div style={{display:"flex",gap:10,alignItems:"center"}}>
                    <div style={{width:36,height:36,background:"#dcfce7",borderRadius:9,display:"flex",alignItems:"center",justifyContent:"center",fontSize:20}}>{sIcon(a.especie)}</div>
                    <div>
                      <div style={{fontWeight:700,fontSize:14}}>{a.nome}</div>
                      <div style={{fontSize:12,color:MU}}>{a.tipo_sanguineo}</div>
                    </div>
                  </div>
                  <Btn v="outline" style={{fontSize:12,padding:"8px 14px"}} onClick={()=>openModal("coleta",{animalId:a.id},{data_coleta:todayStr()})}>Coletar</Btn>
                </div>;
              })
            }
          </Card>
        </div>}

